{
  "manifest_version": 3,
  "name": "Glypdl - Media Downloader Companion",
  "version": "1.0.0",
  "description": "Detects video & audio media streams (YouTube, HTML5, HLS, DASH) and sends downloads directly to the Glypdl desktop application.",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "glypdl@suresh.io",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background/index.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "css": ["content/index.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Glypdl Media Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage",
    "contextMenus",
    "notifications",
    "webRequest"
  ],
  "commands": {
    "send-media-to-glypdl": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Send detected media on active tab to Glypdl"
    }
  }
}
