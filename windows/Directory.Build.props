<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>Suresh Soundararajan</Company>
    <Authors>Suresh Soundararajan</Authors>
    <Product>Glypdl for Windows 11</Product>
    <Copyright>Copyright © 2026 Suresh Soundararajan</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- Default platform to x64 for Self-Contained WinUI 3 -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Platforms>x64;ARM64</Platforms>
    <UseRidGraph>true</UseRidGraph>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Prevent MSVC folder probe on managed C# projects without C++ workloads -->
    <VCToolsInstallDir Condition="'$(VCToolsInstallDir)' == ''">None</VCToolsInstallDir>
  </PropertyGroup>
</Project>
