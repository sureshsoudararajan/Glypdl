<Window
    x:Class="Glypdl.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Glypdl.Windows"
    xmlns:views="using:Glypdl.Windows.Views">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <Image Source="Assets/icon.png" Width="18" Height="18" />
                <TextBlock Text="Glypdl" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            x:FieldModifier="public"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="220"
            CompactPaneLength="48"
            IsSettingsVisible="True"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Add Download" Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="Downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame" x:FieldModifier="public" />
            </NavigationView.Content>
        </NavigationView>

        <!-- Engine Setup Overlay (Displayed automatically if yt-dlp or FFmpeg are missing) -->
        <Grid
            x:Name="EngineSetupOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="32,28"
                MaxWidth="480"
                Width="440">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Image Source="Assets/icon.png" Width="32" Height="32" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="Setting Up Media Engines" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            <TextBlock Text="Downloading required engine components..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Text="Glypdl requires the latest yt-dlp engine and FFmpeg converter to download and extract media. This automatic setup runs only once."
                        TextWrapping="Wrap"
                        FontSize="13"
                        Opacity="0.85" />

                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <Grid>
                            <TextBlock x:Name="EngineStageText" Text="Preparing download..." FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Left" />
                            <TextBlock x:Name="EnginePercentText" Text="0%" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>

                        <ProgressBar
                            x:Name="EngineProgressBar"
                            Value="0"
                            Maximum="100"
                            IsIndeterminate="False"
                            Height="6"
                            CornerRadius="3" />

                        <TextBlock x:Name="EngineDetailText" Text="Connecting to server..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
