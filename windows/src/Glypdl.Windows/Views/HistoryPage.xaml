<Page
    x:Class="Glypdl.Windows.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Glypdl.Windows.Converters"
    xmlns:models="using:Glypdl.Windows.Models"
    xmlns:vm="using:Glypdl.Windows.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolConverter" />
    </Page.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="48,28,48,48" HorizontalAlignment="Stretch">
            <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                
                <!-- Header & Search & Clear -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="History" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                        <TextBlock Text="Past downloads records" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                    </StackPanel>

                    <AutoSuggestBox
                        Grid.Column="1"
                        PlaceholderText="Search title or uploader..."
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                        QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                        TextChanged="AutoSuggestBox_TextChanged"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Width="320" />

                    <Button
                        Grid.Column="2"
                        Content="Clear All"
                        Command="{x:Bind ViewModel.ClearAllHistoryCommand}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Empty State Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="48"
                    Visibility="{x:Bind CountToEmptyVisibility(ViewModel.HistoryEntries.Count), Mode=OneWay}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No Download History" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="Videos and audio files you download will appear here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- History List -->
                <ListView
                    ItemsSource="{x:Bind ViewModel.HistoryEntries, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{x:Bind CountToListVisibility(ViewModel.HistoryEntries.Count), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:HistoryEntry">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0,0,0,10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" Height="68" Width="120">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8B9;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image
                                                Source="{x:Bind ThumbnailPath, Converter={StaticResource ImageConverter}, Mode=OneWay}"
                                                Stretch="UniformToFill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Title, Meta & Date -->
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="14" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Uploader}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{x:Bind Quality}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{x:Bind FormattedDate}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Size & Status -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2" Margin="0,0,16,0">
                                        <TextBlock Text="{x:Bind FormattedSize}" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="13" />
                                        <TextBlock Text="{x:Bind Status}" Foreground="{ThemeResource SystemAccentColor}" FontSize="11" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <!-- Context Actions -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <Button
                                            ToolTipService.ToolTip="Play Media"
                                            Click="PlayButton_Click"
                                            Visibility="{x:Bind IsFileAvailable, Converter={StaticResource BoolConverter}, Mode=OneWay}"
                                            Padding="10,8">
                                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                                        </Button>
                                        <Button
                                            ToolTipService.ToolTip="Open Folder"
                                            Click="OpenFolderButton_Click"
                                            Padding="10,8">
                                            <FontIcon Glyph="&#xED25;" FontSize="13" />
                                        </Button>
                                        <Button
                                            ToolTipService.ToolTip="Re-download (Choose Format)"
                                            Click="DownloadAgainButton_Click"
                                            Padding="10,8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
