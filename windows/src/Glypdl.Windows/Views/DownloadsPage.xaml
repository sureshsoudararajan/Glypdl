<Page
    x:Class="Glypdl.Windows.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Glypdl.Windows.Models"
    xmlns:vm="using:Glypdl.Windows.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Stretch">
            <!-- Header with Clear Button -->
            <Grid>
                <TextBlock Text="Active Downloads" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button
                    Content="Clear Completed"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.ClearCompletedCommand}" />
            </Grid>

            <!-- Active Downloads List -->
            <ListView
                ItemsSource="{x:Bind ViewModel.ActiveDownloads, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadItem">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,12">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Image
                                    Grid.Column="0"
                                    Source="{x:Bind ThumbnailUrl, Mode=OneWay}"
                                    Stretch="UniformToFill"
                                    Height="78"
                                    CornerRadius="4" />

                                <!-- Info & Progress -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Uploader, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                                    <!-- Progress Bar -->
                                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" />

                                    <!-- Stats Grid -->
                                    <Grid>
                                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind FormattedSize, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                    <Button
                                        ToolTipService.ToolTip="Cancel"
                                        Command="{Binding DataContext.CancelDownloadCommand, ElementName=DownloadsPageRoot}"
                                        CommandParameter="{x:Bind}">
                                        <FontIcon Glyph="&#xE711;" />
                                    </Button>
                                    <Button
                                        ToolTipService.ToolTip="Open Folder"
                                        Command="{Binding DataContext.OpenFolderCommand, ElementName=DownloadsPageRoot}"
                                        CommandParameter="{x:Bind}">
                                        <FontIcon Glyph="&#xED25;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
