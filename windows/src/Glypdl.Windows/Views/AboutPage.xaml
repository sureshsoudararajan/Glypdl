<Page
    x:Class="Glypdl.Windows.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Glypdl.Windows.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="48,28,48,48" HorizontalAlignment="Stretch">
            <StackPanel Spacing="20" MaxWidth="680" HorizontalAlignment="Center">
                <!-- App Logo / Title -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Border CornerRadius="16" Width="80" Height="80" HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/icon.png" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Glypdl" Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="A lightweight native Windows 11 media downloader powered by yt-dlp" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" FontSize="13" />
                    <TextBlock Text="Version 1.0.0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" FontSize="12" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Author Info -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Author &amp; Project" FontWeight="SemiBold" FontSize="14" />
                        <Grid>
                            <TextBlock Text="Developer" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.Author}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2" />
                        <Grid>
                            <TextBlock Text="License" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.License}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Open Source Software -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Open Source Software" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                        
                        <!-- yt-dlp Item -->
                        <Button Click="YtDlpItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" Background="Transparent" BorderThickness="0" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="yt-dlp" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.YtDlpVersion, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Unlicense" FontSize="11" />
                                </Border>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,-2" />

                        <!-- FFmpeg Item -->
                        <Button Click="FFmpegItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" Background="Transparent" BorderThickness="0" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="FFmpeg" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.FFmpegVersion, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="LGPL/GPL" FontSize="11" />
                                </Border>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,-2" />

                        <!-- FFprobe Item -->
                        <Button Click="FFprobeItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" Background="Transparent" BorderThickness="0" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="FFprobe" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.FFprobeVersion, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="FFmpeg" FontSize="11" />
                                </Border>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,-2" />

                        <!-- Other Dependencies Item -->
                        <Button Click="OtherDependenciesItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" Background="Transparent" BorderThickness="0" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Other Dependencies" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="WinUI 3, CommunityToolkit, SQLite, Dapper..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Various" FontSize="11" />
                                </Border>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Updates & Support -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Updates &amp; Support" FontWeight="SemiBold" FontSize="14" />
                        <Button
                            Content="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Content="GitHub Repository"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.OpenUrlCommand}"
                                CommandParameter="{x:Bind ViewModel.GitHubUrl}" />
                            <Button
                                Grid.Column="1"
                                Content="Report an Issue"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.OpenUrlCommand}"
                                CommandParameter="{x:Bind ViewModel.IssuesUrl}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
