#!/usr/bin/env python3
"""Glypdl Native Messaging Host executable."""

import sys
import os
import glob
from pathlib import Path

bin_dir = Path(__file__).resolve().parent
prefix_share = bin_dir.parent / "share" / "glypdl"
src_dir = bin_dir.parent / "src"

search_paths = [
    str(src_dir),
    str(prefix_share),
    "/usr/share/glypdl",
    "/app/share/glypdl",
    "/usr/local/share/glypdl",
]

for pattern in ["/usr/lib/python3*/site-packages", "/usr/lib64/python3*/site-packages"]:
    search_paths.extend(glob.glob(pattern))

for p in search_paths:
    if os.path.isdir(p) and p not in sys.path:
        sys.path.insert(0, p)

from glypdl.services.native_host import run_native_host_loop

if __name__ == '__main__':
    run_native_host_loop()
